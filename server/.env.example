# Copy this file to .env and adjust.

PORT=5000
NODE_ENV=development

# Local dev: `npm run db` starts MongoDB on this address (no install needed).
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_darshan
MONGO_URI=mongodb://127.0.0.1:27017/smart_darshan

# Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL(s), comma-separated. Used for CORS and links in SMS messages.
CLIENT_URL=http://localhost:5173

# Python prediction service (ml-service/).
ML_SERVICE_URL=http://127.0.0.1:8000

# Load demo data automatically when the database is empty.
AUTO_SEED=true

# Twilio SMS (optional). Leave blank to log SMS messages to the console instead.
DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL of POST /api/sms/inbound; when set, Twilio signatures are verified.
TWILIO_WEBHOOK_URL=
